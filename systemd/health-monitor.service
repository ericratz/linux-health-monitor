[Unit]
# Runs on the host, not in a container: systemctl, journalctl, ss -tulnp and
# host-scope process/disk views are meaningless from inside a namespace.
Description=Linux Health Monitor (oneshot collection)
Documentation=https://github.com/ericratz/linux-health-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Root is required for the privileged parts of the report: process names in
# `ss -tulnp`, the system journal, and unit state via systemctl. Everything
# still degrades gracefully if you drop this to an unprivileged user, you just
# get fewer fields.
User=root

WorkingDirectory=/opt/linux-health-monitor
# No --no-exit-code here, deliberately: the run exits 0 HEALTHY, 1 WARNING,
# 2 CRITICAL, so `systemctl is-failed health-monitor.service` is an alerting
# signal on its own. Two consequences worth knowing before you "fix" either:
#   - a WARNING leaves this unit in `failed` until the next healthy run. That
#     is the signal working, not a bug. get_failed_services() excludes this
#     unit from its own count, so one WARNING cannot sustain the next.
#   - systemd logs each failed run at err priority, so the journal error count
#     picks it up. Harmless (journal volume never affects the exit code) and
#     honest: those entries say the monitor is warning.
ExecStart=/usr/bin/python3 -m agent.monitor --all --html report.html

Environment=PYTHONPATH=/opt/linux-health-monitor
Environment=PYTHONUNBUFFERED=1

# --- Per-host configuration -------------------------------------------------
# Shipped with node1's values live. THIS FILE IS COPIED VERBATIM TO EVERY HOST:
# do not hand-edit it on a node. Per-host divergence belongs in a drop-in under
# /etc/systemd/system/health-monitor.service.d/, because upgrading means copying
# this file over the installed one - which destroys any local edit, silently,
# while the service keeps starting and reporting. See systemd/node2.conf.

# Units worth watching. Genuinely differs per host: node1 runs Docker, node2
# runs rootless Podman; the SSH unit is `ssh` on Debian and `sshd` on RHEL.
# A unit that is not installed reports `not-installed` rather than `inactive`,
# so naming one that has not been deployed yet is harmless and self-explanatory
# (prometheus reads that way wherever it runs as a container rather than a unit).
Environment=HEALTH_SERVICES=nginx,docker,keepalived,prometheus,ssh

# Rootless Podman: containers belong to the user that started them, so root's
# `podman ps` sees an empty store. Naming the owner lets the monitor look in
# the right place. Unset here because node1's Docker runs as root; node2 sets
# it in its drop-in.

# Application endpoints, as name=url pairs. Pointing each node at BOTH nodes
# makes either node's report a fleet-wide dashboard. Identical on both nodes:
# fleet-slo is 127.0.0.1 so each node reports its own SLO view, and the vip
# entry shows who is answering on the floating address - its `node` field names
# the responder. Which node actually *holds* the VIP is HEALTH_VIP, below.
Environment=HEALTH_APP_ENDPOINTS=node1-health=http://192.168.71.251:8000/health,node2-health=http://192.168.71.252:8000/health,fleet-slo=http://127.0.0.1:8000/slo,vip=http://192.168.71.250/health
Environment=HEALTH_APP_TIMEOUT=2

# The floating address, checked against this host's own interfaces. Same value
# on both nodes: each reports true or false for itself, and split-brain is two
# reports that both say held. Never affects the health status - holding nothing
# is the correct state for the backup node.
Environment=HEALTH_VIP=192.168.71.250

# How far back to count journal errors. Kept near the timer interval (2min) so
# successive reports do not re-count the same errors: at -1h a single burst
# stays in the alerts for a full hour after it is over.
Environment=HEALTH_JOURNAL_WINDOW=-15min

# Alert thresholds (percentages).
#Environment=HEALTH_CPU_WARN=70
#Environment=HEALTH_CPU_CRIT=85
#Environment=HEALTH_MEM_WARN=70
#Environment=HEALTH_MEM_CRIT=85
#Environment=HEALTH_DISK_WARN=80
#Environment=HEALTH_DISK_CRIT=90

# A collection run samples for well under a second; if it wedges on a hung
# mount or an unreachable endpoint, fail rather than pile up runs.
TimeoutStartSec=60

# --- Hardening --------------------------------------------------------------
# Deliberately modest. This service's whole job is to observe the host, so
# sandboxing that hides /proc, /sys or the journal defeats the point.
ProtectSystem=full
ReadWritePaths=/opt/linux-health-monitor/reports
PrivateTmp=yes

# NoNewPrivileges is deliberately NOT set. It sounds like an obvious win for a
# read-only collector, but on an SELinux host it denies podman's transition
# into its own container_runtime_t domain, so podman runs in this service's
# unconfined domain instead and every run logs an audit denial:
#
#   avc: denied { nnp_transition } scontext=...:unconfined_service_t
#        tcontext=...:container_runtime_t tclass=process2
#
# Measured on Rocky 10: the denial appeared on every 2-minute run, which buries
# real findings in the audit log, and leaves podman running less confined than
# its own policy intends. Removing the flag clears it (verified: no matches).
# It would also block `su` (setuid) if HEALTH_CONTAINER_USER is set for a
# rootless runtime. The service already runs as root by design, so the flag
# buys little here.

# ProtectHome hides /home. Safe for a root Docker or root Podman runtime, whose
# state lives under /var/lib/containers. A host that sets HEALTH_CONTAINER_USER
# must override this to `no` in its drop-in: `su -` needs the target user's
# home to build their login session.
ProtectHome=yes

[Install]
WantedBy=multi-user.target
